# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 커밋하지 않는다.

# 외부 API 인증키
OPENAI_API_KEY=
KIPRIS_API_KEY=
DART_API_KEY=

# NAVER API HUB(네이버클라우드) Application 인증키
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 검색어 트렌드(Search Trend)를 활성화한 Application 인증키 (시장 검색 관심도 흐름)
NAVER_TREND_CLIENT_ID=
NAVER_TREND_CLIENT_SECRET=

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding 값). 조달청_나라장터 입찰공고정보서비스 활용신청 필요
DATA_GO_KR_SERVICE_KEY=

# 공용 Chroma: 비우면 기존 로컬 폴더를 사용한다.
# SSH 터널로 접속할 때 127.0.0.1 / 18000 / false
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
# HTTPS 공용 접속 시 개인별 발급 키. 키가 있으면 SSL=true 필수.
CHROMA_API_KEY=
