# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 커밋하지 않는다.

# 외부 API 인증키
OPENAI_API_KEY=
KIPRIS_API_KEY=
DART_API_KEY=

# NAVER API HUB(네이버클라우드) Application 인증키
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공용 Chroma: 비우면 기존 로컬 폴더를 사용한다.
# SSH 터널로 접속할 때 127.0.0.1 / 18000 / false
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
# HTTPS 공용 접속 시 개인별 발급 키. 키가 있으면 SSL=true 필수.
CHROMA_API_KEY=

# 사업기획 근거 자료집: 1이면 로컬 화면에 '새 자료집 만들기'(NAVER·OpenAI 호출) 버튼을 켠다. 배포 환경은 비워 둔다.
IDEALENS_PLANNER_REFRESH=
# 자료집 실행 폴더 위치(비우면 data/market/runs)
IDEALENS_PLANNER_RUNS_DIR=
