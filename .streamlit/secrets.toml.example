# Streamlit Community Cloud 앱 설정의 'Secrets' 칸에 붙여 넣는 형식 예시. 값은 비워 두며 실제 값은 저장소에 커밋하지 않는다.
# 최상위 키는 앱 안에서 환경변수로도 읽히므로 .env와 같은 이름을 쓴다.
OPENAI_API_KEY = ""
KIPRIS_API_KEY = ""
CHROMA_HOST = ""
CHROMA_PORT = "443"
CHROMA_SSL = "true"
CHROMA_API_KEY = ""          # 호스팅 앱 전용 키(개인 키와 분리해 따로 폐기할 수 있게 한다)
IDEALENS_APP_PASSWORD = ""   # 접속 비밀번호. 비우면 누구나 유료 분석을 실행할 수 있다
# 시장 화면이 분석 때 직접 조회하는 보조 자료. 비우면 해당 영역만 오류로 표시되고 보고서 본문은 유지된다.
NAVER_TREND_CLIENT_ID = ""      # 검색 관심도 (NAVER Search Trend, 뉴스 검색 키와 별도 Application)
NAVER_TREND_CLIENT_SECRET = ""
DATA_GO_KR_SERVICE_KEY = ""     # 나라장터 입찰공고 (공공데이터포털 일반 인증키, Decoding 값)
DART_API_KEY = ""               # 인접 기업 재무 현황 (OpenDART)
