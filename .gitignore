
# ============================================================
# IdeaLens - .gitignore
# ============================================================

# ------------------------------------------------------------
# 1. Python cache and compiled files
# ------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# ------------------------------------------------------------
# 2. Virtual environments and local Python settings
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
.pdm-python
__pypackages__/

# ------------------------------------------------------------
# 3. Environment variables and secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
.pypirc

# ------------------------------------------------------------
# 4. Python packaging and build artifacts
# ------------------------------------------------------------
.Python
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
*.egg
*.egg-info/
.installed.cfg
MANIFEST
wheels/
sdist/
parts/
lib/
lib64/
var/
share/python-wheels/

# ------------------------------------------------------------
# 5. Testing, coverage and static analysis
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover
*.lcov
cover/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.cache/

# ------------------------------------------------------------
# 6. IDE and editor files
# ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

*.swp
*.swo
*~
tempCodeRunnerFile.py

# ------------------------------------------------------------
# 7. Jupyter and IPython
# ------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ------------------------------------------------------------
# 8. Framework and runtime files
# ------------------------------------------------------------
*.log
instance/
.webassets-cache/
db.sqlite3
db.sqlite3-journal

celerybeat-schedule*
celerybeat.pid

*.rdb
*.aof
*.pid
mnesia/
rabbitmq/
rabbitmq-data/

# ------------------------------------------------------------
# 9. IdeaLens - Raw and processed data
# ------------------------------------------------------------
/data/raw/**
!/data/raw/.gitkeep

/data/processed/**
!/data/processed/.gitkeep

# Patent raw data
/data/patents/raw/**
!/data/patents/raw/.gitkeep

# Market raw data
/data/market/raw/**
!/data/market/raw/.gitkeep

# ------------------------------------------------------------
# 10. IdeaLens - Vector databases and indexes
# ------------------------------------------------------------
/data/indexes/**
!/data/indexes/.gitkeep

/data/patents/chroma/**
!/data/patents/chroma/.gitkeep

# Additional local vector database files
*.faiss
*.index

# ------------------------------------------------------------
# 11. Generated reports
# ------------------------------------------------------------
/reports/**
!/reports/.gitkeep

# ------------------------------------------------------------
# 12. Operating system files
# ------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.Trash-*/
.nfs*

# ------------------------------------------------------------
# 13. Temporary and installer files
# ------------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt
*.tmp
*.temp